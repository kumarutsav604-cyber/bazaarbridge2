# Aiven PostgreSQL (System of record)
PG_URI=

# Aiven Kafka (Exactly 2 topics x 2 partitions)
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CA_PATH=
KAFKA_SERVICE_CERT_PATH=
KAFKA_SERVICE_KEY_PATH=

# Aiven OpenSearch (Typo-tolerant discovery)
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Application Secrets
JWT_SECRET=
OTP_HASH_SECRET=
SEED_ADMIN_PASSWORD=

# Optional AI Shopping Assistant (Server-side only, never exposed to browser)
GEMINI_API_KEY=

# Feature Flags
FEATURE_FLAGS=FEATURE_COUPONS,FEATURE_WISHLIST,FEATURE_ALERTS,FEATURE_ADDRESSES,FEATURE_SAVE_LATER,FEATURE_COMPARE,FEATURE_ASSISTANT,FEATURE_REVIEWS,FEATURE_SUPPORT,FEATURE_SIM_SCREENS

# Runtime
FRONTEND_URL=
APP_URL=
PORT=3000
